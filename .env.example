# Docker Compose interpolation only.
# Do not source this file into Retsu application processes.
# Application overrides use names such as RETSU_DATABASE__URL.

COMPOSE_PROJECT_NAME=retsu

RETSU_LOCAL_IMAGE=retsu-local:dev
RETSU_LOCAL_API_PORT=2424
RETSU_LOCAL_CLEANER_PORT=24247
RETSU_LOCAL_COLLECTOR_PORT=24252
RETSU_LOCAL_DLQ_CLEANER_PORT=24253
RETSU_LOCAL_LOG_FILTER=warn
RETSU_LOCAL_TRACES_ENABLED=false
RETSU_LOCAL_TRACE_FILTER=warn
RETSU_LOCAL_METRICS_MAX_QUEUES=1000
RETSU_LOCAL_QUEUE_NAMES_CACHE_MAX_ENTRIES=1000
RETSU_LOCAL_QUEUE_NAMES_CACHE_MAX_CAPACITY_BYTES=2097152
RETSU_LOCAL_EXPIRED_MESSAGE_CLEANER_INTERVAL_SECONDS=60
RETSU_LOCAL_EXPIRED_MESSAGE_CLEANER_BATCH_SIZE=500
RETSU_LOCAL_EXPIRED_MESSAGE_CLEANER_SATURATED_BATCH_DELAY_MILLISECONDS=50
RETSU_LOCAL_DLQ_RETENTION_SECONDS=3600
RETSU_LOCAL_DLQ_CLEANER_INTERVAL_SECONDS=60
RETSU_LOCAL_DLQ_CLEANER_BATCH_SIZE=500
RETSU_LOCAL_DLQ_CLEANER_SATURATED_BATCH_DELAY_MILLISECONDS=50

RETSU_LOCAL_POSTGRES_DB=retsu
RETSU_LOCAL_POSTGRES_USER=retsu
RETSU_LOCAL_POSTGRES_PASSWORD=retsu_local
RETSU_LOCAL_POSTGRES_PORT=24240
RETSU_LOCAL_PGBOUNCER_PORT=24250

RETSU_LOCAL_DISTRIBUTED_CACHE_PORT=24251

RETSU_LOCAL_POSTGRES_MONITOR_USER=retsu_monitor
RETSU_LOCAL_POSTGRES_MONITOR_PASSWORD=retsu_monitor_local

RETSU_LOCAL_OTLP_GRPC_PORT=24241
RETSU_LOCAL_OTLP_HTTP_PORT=24242
RETSU_LOCAL_OTEL_HEALTH_PORT=24243
RETSU_LOCAL_TEMPO_PORT=24244
RETSU_LOCAL_PROMETHEUS_PORT=24245

RETSU_LOCAL_GRAFANA_PORT=24246
RETSU_LOCAL_GRAFANA_USER=admin
RETSU_LOCAL_GRAFANA_PASSWORD=retsu_local

RETSU_LOCAL_PG_EXPORTER_PORT=24248

RETSU_LOCAL_POSTGRES_SLOW_QUERY_MS=-1 # use 250 when we need slow query logging is needed
RETSU_LOCAL_POSTGRES_LOG_TEMP_FILES_KB=1024
RETSU_LOCAL_CADVISOR_PORT=24249

# Disposable local k6 runner. Scenario rates and durations use the variables
# documented in load/k6/README.md and can be supplied per command.
MESSAGE_TTL_SECONDS=180
VISIBILITY_TIMEOUT_SECONDS=10
MAX_DELIVERY_ATTEMPTS=3

# Local showcase defaults. The command accepts a total run time from five
# through twenty minutes.
SHOWCASE_DURATION_MINUTES=5
SHOWCASE_CONSUMER_HEADROOM=1.3
SHOWCASE_PRODUCER_PRE_ALLOCATED_VUS=32
SHOWCASE_PRODUCER_MAX_VUS=128
SHOWCASE_CONSUMER_PRE_ALLOCATED_VUS=256
SHOWCASE_CONSUMER_MAX_VUS=384
SHOWCASE_DRAIN_RATE=195
SHOWCASE_DRAIN_RAMP_UP_SECONDS=1
SHOWCASE_DRAIN_HOLD_SECONDS=29
SHOWCASE_DRAIN_RAMP_DOWN_SECONDS=2
