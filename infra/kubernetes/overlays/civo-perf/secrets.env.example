# Copy this file to secrets.env and replace every placeholder.
# Keep the password URL-encoded in RETSU_DATABASE_URL when it has reserved URL characters.
POSTGRES_DB=retsu
POSTGRES_USER=retsu
POSTGRES_PASSWORD=replace-with-a-random-password
RETSU_DATABASE_URL=postgres://retsu:replace-with-a-random-password@postgres:5432/retsu
